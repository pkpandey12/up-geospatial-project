# Copy to .env (make setup does this for you) and change the values.
# .env is git-ignored; this file is the committed template, so put no real secrets here.

# --- Local PostGIS container (docker-compose.yml reads these)
POSTGRES_USER=up_siting
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=up_siting
# Host port the container is published on. Change it if something else already uses 5432
# (for example a Postgres installed with apt).
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
