{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "How district supply of this input is estimated from another district variable.\n\ne.g. C-heavy molasses = cane crushed x 0.045; paddy straw = rice production x 1.5.",
      "properties": {
        "from_variable": {
          "description": "District variable, e.g. 'sugarcane' production.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "From Variable",
          "type": "string"
        },
        "ratio": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tonnes of this input per tonne of from_variable.",
          "title": "Ratio"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        }
      },
      "required": [
        "from_variable",
        "ratio"
      ],
      "title": "Availability",
      "type": "object"
    },
    "Buyer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "id"
      ],
      "title": "Buyer",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "strong",
        "moderate",
        "weak"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "LandRule": {
      "additionalProperties": false,
      "description": "Partners' land rule: plot_acres = fixed_acres + acres_per_tpd x tpd.",
      "properties": {
        "fixed_acres": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fixed Acres"
        },
        "acres_per_tpd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acres Per Tpd"
        }
      },
      "required": [
        "fixed_acres",
        "acres_per_tpd"
      ],
      "title": "LandRule",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Citation, or 'partner' for private values.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source",
        "confidence"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RawMaterial": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inputs sharing a route are used together; routes are alternatives.",
          "title": "Route"
        },
        "tonnes_per_tonne_output": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tonnes of this input per tonne of output, at reference quality.",
          "title": "Tonnes Per Tonne Output"
        },
        "price_inr_per_tonne": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Statewide price if regulated (e.g. cane SAP); null if it varies by district.",
          "title": "Price Inr Per Tonne"
        },
        "quality_measure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "District quality variable, e.g. 'sugar_recovery_pct'; null = factor 1.0.",
          "title": "Quality Measure"
        },
        "reference_quality": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Value of quality_measure at which tonnes_per_tonne_output applies.",
          "title": "Reference Quality"
        },
        "availability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Availability"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible": {
          "default": true,
          "title": "Eligible",
          "type": "boolean"
        },
        "eligibility_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligibility Note"
        }
      },
      "required": [
        "id",
        "route",
        "tonnes_per_tonne_output",
        "price_inr_per_tonne",
        "quality_measure",
        "reference_quality",
        "availability"
      ],
      "title": "RawMaterial",
      "type": "object"
    },
    "TpdRange": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max"
        },
        "default": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default"
        }
      },
      "required": [
        "min",
        "max",
        "default"
      ],
      "title": "TpdRange",
      "type": "object"
    },
    "WaterQuality": {
      "additionalProperties": false,
      "properties": {
        "grade": {
          "anyOf": [
            {
              "enum": [
                "any",
                "raw",
                "treated",
                "potable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grade"
        },
        "max_tds_mg_per_l": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum total dissolved solids.",
          "title": "Max Tds Mg Per L"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "grade",
        "max_tds_mg_per_l"
      ],
      "title": "WaterQuality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "product_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Product Id",
      "type": "string"
    },
    "product_name": {
      "title": "Product Name",
      "type": "string"
    },
    "output_unit_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Unit Note"
    },
    "raw_materials": {
      "items": {
        "$ref": "#/$defs/RawMaterial"
      },
      "minItems": 1,
      "title": "Raw Materials",
      "type": "array"
    },
    "default_route": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Default Route"
    },
    "kwh_per_tonne_output": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Kwh Per Tonne Output"
    },
    "kl_water_per_tonne_output": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Kl Water Per Tonne Output"
    },
    "water_quality": {
      "$ref": "#/$defs/WaterQuality"
    },
    "buyers": {
      "items": {
        "$ref": "#/$defs/Buyer"
      },
      "title": "Buyers",
      "type": "array"
    },
    "max_sourcing_distance_km": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Sourcing Distance Km"
    },
    "land": {
      "$ref": "#/$defs/LandRule"
    },
    "tpd_range": {
      "$ref": "#/$defs/TpdRange"
    },
    "operating_days_per_year": {
      "anyOf": [
        {
          "maximum": 366,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Operating Days Per Year"
    },
    "project_life_years": {
      "anyOf": [
        {
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Life Years"
    },
    "provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "object"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "schema_version",
    "product_id",
    "product_name",
    "raw_materials",
    "default_route",
    "kwh_per_tonne_output",
    "kl_water_per_tonne_output",
    "water_quality",
    "buyers",
    "max_sourcing_distance_km",
    "land",
    "tpd_range",
    "operating_days_per_year",
    "project_life_years"
  ],
  "title": "ProductProfile",
  "type": "object"
}
